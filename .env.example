# Copy this to .env.local and fill in real values. .env.local is gitignored.
# If this project is linked to Vercel, `vercel env pull .env.local` fills the
# DATABASE_URL / Neon vars automatically.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Password reset and security emails (Resend, https://resend.com). Without both, the "Forgot your
# password?" link is hidden in production; in development the email is printed to the server console.
# EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="AP Study App <noreply@your-domain.example>"
# Optional: where replies to those emails go.
EMAIL_REPLY_TO=""
# The address links in emails point at (never taken from the request). Defaults to the production URL.
SITE_URL=""
